# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-here-change-in-production-min-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Gmail SMTP Configuration (for password reset emails)
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password-here

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Security Settings (for production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
